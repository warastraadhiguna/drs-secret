# Salin file ini ke .env lalu isi. JANGAN pernah commit/kirim .env yang asli.
# Nilai di bawah = contoh utk SERVER PRODUKSI (Ubuntu + Nginx + MariaDB).
# Untuk laptop (WAMP) cukup: NODE_ENV=development, HOST=0.0.0.0, DB_PORT=3306,
# DB_USER=root, dan MYSQLDUMP_PATH ke mysqldump WAMP.

# --- Server ---
NODE_ENV=production
PORT=4101
# 127.0.0.1 = cuma bisa diakses lewat Nginx di server itu sendiri, tidak
# langsung dari internet.
HOST=127.0.0.1
# Opsional — kosongkan kalau folder pos-admin bertetangga dgn folder server.
# ADMIN_DIST_PATH=/var/www/drs-secret/pos-admin/dist
# Opsional — cuma kalau ada frontend di domain LAIN yang perlu memanggil API.
# CORS_ORIGIN=

# --- Database (MariaDB/MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=5431
DB_USER=drs_secret
DB_PASSWORD=ISI_PASSWORD_USER_DATABASE
DB_NAME=pos_drs

# --- Auth ---
# WAJIB string acak panjang (min 32 karakter): openssl rand -base64 48
JWT_SECRET=ISI_HASIL_openssl_rand_-base64_48
JWT_EXPIRES_IN=12h

# --- Seed (dipakai SEKALI saat instalasi pertama: npm run db:seed) ---
# Password awal user 'admin' (superadmin) & 'admin2' — min 10 karakter.
# Segera ganti lewat aplikasi setelah login pertama.
SEED_ADMIN_PASSWORD=ISI_PASSWORD_AWAL_KUAT
# Kosongkan di produksi = user kasir PIN tidak dibuat.
SEED_CASHIER_PIN=

# --- Backup database ---
# mysqldump ada di PATH Ubuntu — biasanya tidak perlu diisi.
# MYSQLDUMP_PATH=/usr/bin/mysqldump
